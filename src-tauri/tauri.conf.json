{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Outilo",
  "version": "0.6.0",
  "identifier": "xyz.outilo.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Outilo",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: http://outilo-ext.localhost outilo-ext:",
        "font-src": "'self' data:",
        "frame-src": "http://outilo-ext.localhost outilo-ext:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Outilo",
    "copyright": "Apache-2.0",
    "category": "DeveloperTool",
    "shortDescription": "La boîte à outils extensible",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../extensions/": "extensions/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French",
          "English"
        ]
      }
    }
  }
}
